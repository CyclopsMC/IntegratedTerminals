{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["gradle"],
  "regexManagers": [
    {
      "fileMatch": ["(^|/)gradle\\.properties$"],
      "matchStrings": [
        "minecraft_version\\s*=\\s*(?<mcVersion>\\S+)[\\s\\S]*?(?<depName>[a-z0-9]+)_version\\s*=\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "org.cyclops.${{depName}}:${{depName}}-${{mcVersion}}-neoforge",
      "datasourceTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["maven"],
      "registryUrls": ["https://maven.pkg.github.com/CyclopsMC/packages"]
    }
  ],
  "hostRules": [
    {
      "matchHost": "maven.pkg.github.com",
      "username": "x-access-token",
      "token": "github"
    }
  ]
}
